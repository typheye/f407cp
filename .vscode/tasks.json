{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Play",
      "detail": "Play JAPKit",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Play JAPKit"
      },
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n",
        "janpnp",
        "python",
        "${workspaceFolder}/src/japkit/app.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Build JAPKit with PyInstaller.",
      "type": "shell",
      "icon": {
        "id": "build",
        "tooltip": "Build JAPKit"
      },
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/build.sh"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "detail": "Remove build/, dist/ and Python cache files.",
      "type": "shell",
      "icon": {
        "id": "trash",
        "tooltip": "Clean all"
      },
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/clean.sh"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
